{
  "name": "dsh-tinytitan",
  "version": "0.1.0",
  "description": "DeepSeek Harness route and quiet compaction for a local TinyTitan server",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./backend": "./src/backend.js",
    "./setup": "./src/setup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pummelchen/TinyTitan_Datacenter.git",
    "directory": "plugins/dsh-tinytitan"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.2 || ^0.1.6-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-rc.2 || ^0.1.6-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "tinytitan",
    "qwen",
    "local"
  ]
}
